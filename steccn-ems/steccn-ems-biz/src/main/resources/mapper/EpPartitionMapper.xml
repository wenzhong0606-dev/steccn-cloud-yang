<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.ems.mapper.EpPartitionMapper">

    <resultMap id="BaseResultMap" type="com.steccn.ems.domain.EpPartition">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="type" column="type" jdbcType="INTEGER"/>
            <result property="officeId" column="office_id" jdbcType="INTEGER"/>
            <result property="officeName" column="office_name" jdbcType="VARCHAR"/>
            <result property="sort" column="sort" jdbcType="INTEGER"/>
            <result property="parentId" column="parent_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,type,office_id,
        office_name,sort,parent_id,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag
    </sql>
    <select id="listParentInfo" resultType="com.steccn.ems.vo.EpPartitionVO">
        SELECT
        a.id as childrenId,
        b.id id,
        b.office_id,
        b.office_name,
        b.parent_id,
        c.id AS isParentId,
        c.office_id parentOfficeId,
        c.office_name parentOfficeName
        from
        ep_partition a
        inner join ep_partition b on a.parent_id = b.id
        inner join ep_partition c on b.parent_id = c.id
        where
        a.id in
        <foreach collection="childList" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>

    </select>
</mapper>
