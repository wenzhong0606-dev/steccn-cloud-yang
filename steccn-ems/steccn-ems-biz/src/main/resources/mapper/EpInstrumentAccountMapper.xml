<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.ems.mapper.EpInstrumentAccountMapper">

    <resultMap id="BaseResultMap" type="com.steccn.ems.domain.EpInstrumentAccount">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="partitionNode" column="partition_node" jdbcType="BIGINT"/>
            <result property="meterType" column="meter_type" jdbcType="INTEGER"/>
            <result property="measureUnit" column="measure_unit" jdbcType="BIGINT"/>
            <result property="entityTable" column="entity_table" jdbcType="INTEGER"/>
            <result property="distantMapCode" column="distant_map_code" jdbcType="VARCHAR"/>
            <result property="meterName" column="meter_name" jdbcType="VARCHAR"/>
            <result property="site" column="site" jdbcType="BIGINT"/>
            <result property="siteName" column="site_name" jdbcType="VARCHAR"/>
            <result property="assetsCode" column="assets_code" jdbcType="VARCHAR"/>
            <result property="note" column="note" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="INTEGER"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
            <result property="showFlag" column="show_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,partition_node,meter_type,
        measure_unit,entity_table,distant_map_code,
        meter_name,site,site_name,assets_code,note,
        status,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>
    <select id="meterPartition" resultType="com.steccn.ems.dto.EpDwMeterPartitionDTO">
        SELECT
            ep.type,
            office_id,
            ac.distant_map_code,
            ac.meter_name,
            ac.id as meter_id,
            ep.id as partitionId
        FROM
            ep_partition ep
                JOIN ep_instrument_account ac ON ep.id = ac.partition_node
        where ep.del_flag = 0 and ac.show_flag = 1	and ac.entity_table = 0
        ORDER BY
            ep.type;
    </select>
</mapper>
