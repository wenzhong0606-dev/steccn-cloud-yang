<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsWorkOrderBatchMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsWorkOrderBatch">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="startTime" column="start_time" jdbcType="TIMESTAMP"/>
            <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
            <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
            <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
            <result property="currentBatchFlag" column="current_batch_flag" jdbcType="TINYINT"/>
            <result property="minPackQuantity" column="min_pack_quantity" jdbcType="INTEGER"/>
            <result property="produceOrderId" column="produce_order_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,start_time,
        end_time,quantity,unit_id,
        current_batch_flag,min_pack_quantity,produce_order_id,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag
    </sql>
    <select id="defectDay" resultType="com.steccn.pms.dto.PmsDefectDayOrderBasicDTO">
        SELECT
        o.id as produceOrderId,
        o.`code` as produceOrderCode,
        o.production_line_id as productLineId,
        batch.start_time,
        batch.end_time ,
        o.material_id,
        o.material_name,
        o.customer_id as customerId,
        o.state as state
        FROM
        pms_work_order_batch batch
        JOIN pms_produce_order o ON batch.produce_order_id = o.id
        WHERE
        batch.del_flag = 0
        AND o.del_flag = 0
        AND batch.start_time &gt;= #{begin}
        AND batch.end_time &lt; #{over}
        AND o.production_line_id in
        <foreach collection="lineList" item="lineId" open="(" close=")" separator=",">
            #{lineId}
        </foreach>
    </select>
</mapper>
