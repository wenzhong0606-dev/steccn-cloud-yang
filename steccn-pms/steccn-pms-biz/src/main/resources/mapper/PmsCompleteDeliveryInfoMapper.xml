<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsCompleteDeliveryInfoMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsCompleteDeliveryInfo">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="caseNo" column="case_no" jdbcType="VARCHAR"/>
        <result property="batchNo" column="batch_no" jdbcType="VARCHAR"/>
        <result property="packTime" column="pack_time" jdbcType="TIMESTAMP"/>
        <result property="state" column="state" jdbcType="TINYINT"/>
        <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
        <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
        <result property="completeDeliveryId" column="complete_delivery_id" jdbcType="BIGINT"/>
        <result property="processId" column="process_id" jdbcType="BIGINT"/>
        <result property="createBy" column="create_by" jdbcType="BIGINT"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
        <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,case_no,batch_no,
        pack_time,state,quantity,
        unit_id,complete_delivery_id,process_id,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag,work_order_id
    </sql>
    <select id="listByOrderId" resultType="com.steccn.pms.vo.PmsCompleteDeliveryVO">
        SELECT a.id,
               b.code,
               b.delivery_time,
               b.state,
               a.material_id,
               a.material_name,
               a.material_code,
               a.quantity,
               a.unit_id,
               a.case_no,
               a.batch_no,
               a.warehouse_id,
               a.shelf_id,
               a.process_id
        FROM pms_complete_delivery_info a
                 JOIN pms_complete_delivery b ON a.complete_delivery_id = b.id
        WHERE b.produce_order_id = #{orderId}
    </select>
</mapper>
