<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmBillOfMaterialMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmBillOfMaterial">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="quantity" column="quantity" jdbcType="OTHER"/>
            <result property="unitId" column="unit_id" jdbcType="INTEGER"/>
            <result property="version" column="version" jdbcType="VARCHAR"/>
            <result property="isCurrentVersion" column="is_current_version" jdbcType="TINYINT"/>
            <result property="validBeginTime" column="valid_begin_time" jdbcType="TIMESTAMP"/>
            <result property="validEndTime" column="valid_end_time" jdbcType="TIMESTAMP"/>
            <result property="note" column="note" jdbcType="VARCHAR"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,status,
        quantity,unit_id,version,
        is_current_version,valid_begin_time,valid_end_time,
        note,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>
    <select id="listByCodes" resultType="com.steccn.pms.domain.PmBillOfMaterial">
        select id,code from  pm_bill_of_material
        <where>
            <if test="codeList !=null and codeList.size > 0">
               code in
                <foreach collection="codeList" item="code" open="(" close=")" separator=",">
                    #{code}
                </foreach>
            </if>
        </where>
    </select>

</mapper>
