<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsReportWorkConsumeMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsReportWorkConsume">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="type" column="type" jdbcType="INTEGER"/>
            <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
            <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
            <result property="reportWorkId" column="report_work_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,type,quantity,
        unit_id,report_work_id,create_by,
        create_name,create_time,update_by,
        update_name,update_time,del_flag
    </sql>
    <select id="energyGroup" resultType="com.steccn.pms.vo.EnergyGroupListVO">
        SELECT
            rw.product_line_id,
            rw.class_group_id,
            wc.type,
            sum(wc.quantity) as quantity
        FROM
            pms_report_work rw
                JOIN pms_report_work_consume wc ON rw.id = wc.report_work_id
        WHERE
            product_line_id IN
        <foreach collection="productLineIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
        GROUP BY
            rw.product_line_id,
            rw.class_group_id,
            wc.type
    </select>
</mapper>
