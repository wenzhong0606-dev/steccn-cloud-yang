<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsCompleteDeliveryMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsCompleteDelivery">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="code" column="code" jdbcType="VARCHAR"/>
        <result property="deliveryTime" column="delivery_time" jdbcType="TIMESTAMP"/>
        <result property="materialId" column="material_id" jdbcType="INTEGER"/>
        <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
        <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
        <result property="state" column="state" jdbcType="VARCHAR"/>
        <result property="outStorageVoucher" column="out_storage_voucher" jdbcType="VARCHAR"/>
        <result property="produceOrderId" column="produce_order_id" jdbcType="BIGINT"/>
        <result property="createBy" column="create_by" jdbcType="BIGINT"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
        <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,code,delivery_time,
        material_id,quantity,unit_id,
        state,out_storage_voucher,produce_order_id,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag
    </sql>
    <select id="pageList" resultType="com.steccn.pms.vo.PmsCompleteDeliveryVO">
        SELECT
        b.id,
        a.CODE,
        a.delivery_time,
        b.material_id,
        b.material_name,
        b.material_code,
        b.quantity,
        b.unit_id,
        b.batch_no,
        b.warehouse_id,
        b.shelf_id
        FROM
        pms_complete_delivery a
        JOIN pms_complete_delivery_info b ON a.id = b.complete_delivery_id
        <where>
            a.del_flag = 0
            <if test="dto.startTime !=null and dto.startTime !=null">
                and a.delivery_time &gt;= #{dto.startTime}
            </if>
            <if test="dto.endTime != null and dto.endTime != null">
                and a.delivery_time &lt;= #{dto.endTime}
            </if>
            <if test="dto.material != null and dto.material != null">
                and (material_name LIKE CONCAT(CONCAT('%',#{dto.material}),'%') or material_code LIKE
                CONCAT(CONCAT('%',#{dto.material}),'%'))
            </if>
        </where>
    </select>
    <select id="processNumConsumeMap" resultType="com.steccn.pms.vo.ProduceOrderProcessNumVO">
        SELECT
            pcd.produce_order_id,
            info.process_id,
            info.material_id,
            sum( info.quantity ) as quantity,
            sum( info.ava_quantity ) as avaQuantity
        FROM
            pms_complete_delivery pcd
                JOIN pms_complete_delivery_info info ON info.complete_delivery_id = pcd.id
        WHERE
        pcd.del_flag = 0 AND info.del_flag = 0
        <if test="produceOrderIdSet !=null and produceOrderIdSet.size > 0">
          AND pcd.produce_order_id in
        <foreach collection="produceOrderIdSet" item="code" open="(" close=")" separator=",">
            #{code}
        </foreach>
        </if>
        GROUP BY
            pcd.produce_order_id,
            info.process_id,
            info.material_id



    </select>
    <select id="subIngredientReport" resultType="com.steccn.pms.vo.SubstrateIngredientConsumeVO">
        SELECT
            info.material_id,
            any_value ( info.material_name ) as material_name,
            any_value ( info.material_code ) as material_code,
            sum( info.quantity ) AS quantity ,
            GROUP_CONCAT(DISTINCT pcd.produce_order_id) as produceOrderIdStr
        FROM
            pms_report_work prw
                JOIN pms_complete_delivery pcd on prw.id = pcd.report_work_id
                JOIN pms_complete_delivery_info info ON info.complete_delivery_id = pcd.id
        WHERE
            pcd.del_flag = 0
          AND info.del_flag = 0
          AND DATE_FORMAT( pcd.create_time, '%Y-%m-%d' ) = #{date}
        <if test="productLineIdList !=null and productLineIdList.size > 0">
            AND prw.product_line_id in
            <foreach collection="productLineIdList" item="line" open="(" close=")" separator=",">
                #{line}
            </foreach>
        </if>
        <if test="classesIdList !=null and classesIdList.size > 0">
            AND prw.classes_id in
            <foreach collection="classesIdList" item="classes" open="(" close=")" separator=",">
                #{classes}
            </foreach>
        </if>
        GROUP BY
            info.material_id
    </select>
</mapper>
