<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsReportWorkMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsReportWork">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="code" column="code" jdbcType="VARCHAR"/>
        <result property="processId" column="process_id" jdbcType="BIGINT"/>
        <result property="startTime" column="start_ime" jdbcType="VARCHAR"/>
        <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
        <result property="processQuantity" column="process_quantity" jdbcType="DECIMAL"/>
        <result property="badnessQuantity" column="badness_quantity" jdbcType="DECIMAL"/>
        <result property="batchNo" column="batch_no" jdbcType="VARCHAR"/>
        <result property="classesId" column="classes_id" jdbcType="INTEGER"/>
        <result property="produceLineId" column="produce_line_id" jdbcType="INTEGER"/>
        <result property="stationId" column="station_id" jdbcType="INTEGER"/>
        <result property="classGroupId" column="class_group_id" jdbcType="INTEGER"/>
        <result property="produceOrderId" column="produce_order_id" jdbcType="BIGINT"/>
        <result property="createBy" column="create_by" jdbcType="BIGINT"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
        <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <select id="processReportPage" resultType="com.steccn.pms.vo.ProcessReportWorkPageVO">
        SELECT prw.id,
        prw.CODE,
        prw.produce_order_no,
        prw.produce_order_id,
        pp.CODE AS process_no,
        pp.name AS processName,
        pp.NAME,
        prw.station_id,
        prw.create_time,
        prw.start_time,
        prw.end_time,
        prw.create_name,
        prw.process_quantity,
        prw.badness_quantity,
        prw.unit_id,
        prw.batch_no,
        prw.classes_id
        FROM pms_report_work prw
        JOIN pm_process pp ON pp.id = prw.process_id
        WHERE
        prw.del_flag = 0 AND pp.del_flag = 0
        <if test="dto.processName != null and dto.processName != ''">
            AND pp.name LIKE CONCAT('%',#{dto.processName},'%')
        </if>
        <if test="dto.produceOrderNo != null and dto.produceOrderNo != ''">
            AND prw.produce_order_no LIKE CONCAT('%',#{dto.produceOrderNo},'%')
        </if>
        <if test="dto.stationId != null and dto.stationId != ''">
            AND prw.station_id = #{dto.stationId}
        </if>
        <if test="dto.processId != null and dto.processId != ''">
            AND pp.id = #{dto.processId}
        </if>
        <if test="dto.classesId != null and dto.classesId != ''">
            AND prw.classes_id = #{dto.classesId}
        </if>
        <if test="dto.createTimeStart != null">
            AND prw.create_time &gt;= #{dto.createTimeStart}
        </if>
        <if test="dto.createTimeEnd != null">
            AND prw.create_time &lt;= #{dto.createTimeEnd}
        </if>
        <if test="dto.startTimeStart != null">
            AND prw.start_time &gt;= #{dto.startTimeStart}
        </if>
        <if test="dto.startTimeEnd != null">
            AND prw.start_time &lt;= #{dto.startTimeEnd}
        </if>
        <if test="dto.endTimeStart != null">
            AND prw.end_time &gt;= #{dto.endTimeStart}
        </if>
        <if test="dto.endTimeEnd != null">
            AND prw.end_time &lt;= #{dto.endTimeEnd}
        </if>
    </select>
</mapper>
