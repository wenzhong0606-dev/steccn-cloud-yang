<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsCompleteStorageInfoMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsCompleteStorageInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="caseNo" column="case_no" jdbcType="VARCHAR"/>
            <result property="batchNo" column="batch_no" jdbcType="VARCHAR"/>
            <result property="packTime" column="pack_time" jdbcType="TIMESTAMP"/>
            <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
            <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
            <result property="completeStorageId" column="complete_storage_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,case_no,batch_no,
        pack_time,state,quantity,
        unit_id,complete_storage_id,create_by,
        create_name,create_time,update_by,
        update_name,update_time,del_flag
    </sql>
    <select id="pageByOrderId" resultType="com.steccn.pms.vo.PmsCompleteStorageVO">
        SELECT
            a.id,
            b.code,
            b.in_storage_time,
            b.state,
            a.quantity,
            a.unit_id,
            a.case_no,
            a.batch_no,
            a.print_flag,
            a.print_count
        FROM
            pms_complete_storage_info a
                JOIN pms_complete_storage b ON a.complete_storage_id = b.id
        WHERE
            a.produce_order_id = #{orderId}
    </select>
    <select id="materialList" resultType="com.steccn.pms.vo.FurtherProduceReportDataVO">
        SELECT
            pbp.material_id,
            pbp.classes_id,
            si.create_time,
            sum( si.quantity) as processQuantity
        FROM
            `pms_complete_storage_info` si
                JOIN pms_barcode_print pbp ON pbp.case_no = si.case_no
        WHERE
            pbp.material_id in
            <foreach collection="materialSet" item="id"  open="(" close=")" separator=",">
                #{id}
            </foreach>
        AND si.create_time &gt;= #{start}
        AND si.create_time &lt;= #{end}
        GROUP BY
            pbp.material_id,pbp.classes_id,si.create_time

    </select>
    <select id="existCaseNo" resultType="java.lang.Long">
        select count(1) from pms_complete_storage pcs join pms_complete_storage_info info on pcs.id = info.complete_storage_id
        where pcs.type_id = #{typeId}
          AND info.case_no in
        <foreach collection="caseNoSet" item="id"  open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>
</mapper>
