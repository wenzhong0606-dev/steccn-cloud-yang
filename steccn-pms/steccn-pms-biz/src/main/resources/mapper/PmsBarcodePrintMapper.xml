<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsBarcodePrintMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsBarcodePrint">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="productionLine" column="production_line" jdbcType="INTEGER"/>
            <result property="materialId" column="material_id" jdbcType="INTEGER"/>
            <result property="batchNumber" column="batch_number" jdbcType="VARCHAR"/>
            <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
            <result property="printStrip" column="print_strip" jdbcType="INTEGER"/>
            <result property="printNumber" column="print_number" jdbcType="INTEGER"/>
            <result property="classesId" column="classes_id" jdbcType="INTEGER"/>
            <result property="classGroupId" column="class_group_id" jdbcType="BIGINT"/>
            <result property="caseNo" column="case_no" jdbcType="VARCHAR"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,production_line,material_id,
        batch_number,quantity,print_strip,
        print_number,classes_id,class_group_id,
        case_number,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>

    <select id="caseNoHistory" resultType="com.steccn.pms.vo.PmsCaseNoHistoryVO">
        /*查询箱号创建信息*/
        select
            a.case_no as caseNo,
                '-' as warehouseName,
                '-' as shelfName,
                a.production_line as productLineId,
                b.code as associatedNo,
                a.create_time as operateTime,
                a.create_name as operator,
                a.material_id as materialId,
                a.quantity as quantity,
                '条码创建' AS operateType,
                b.type_id AS typeId
        from pms_barcode_print a
                 JOIN pms_produce_order b on a.produce_order_id = b.id
        where
            a.case_no = #{caseNo}
          and a.del_flag = 0
    </select>
</mapper>
