<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsPullForceMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsPullForce">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="pullForceDate" column="pull_force_date" jdbcType="DATE"/>
            <result property="workshopId" column="workshop_id" jdbcType="INTEGER"/>
            <result property="productLineId" column="product_line_id" jdbcType="INTEGER"/>
            <result property="classesId" column="classes_id" jdbcType="BIGINT"/>
            <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
            <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,pull_force_date,workshop_id,
        product_line_id,classes_id,quantity,
        unit_id,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>

    <select id="selectPullForceByDay" resultType="com.steccn.pms.dto.PmsPullForceDayCountDTO">
        SELECT SUM(quantity) AS quantity,
               DATE_FORMAT(pull_force_date,'%Y-%m-%d') pullForceDateStr
        FROM pms_pull_force
        WHERE del_flag = 0
        AND pull_force_date between #{start} AND #{end}
        AND workshop_id IN
        <foreach collection="idSet" item="id"  open="(" close=")"  separator=",">
            #{id}
        </foreach>
        GROUP BY  pullForceDateStr
    </select>

    <select id="selectPullForceByWeek" resultType="com.steccn.pms.dto.PmsPullForceDayCountDTO">
        SELECT SUM(quantity) AS quantity,
        YEARWEEK(pull_force_date,7) pullForceDateStr
        FROM pms_pull_force
        WHERE del_flag = 0
        AND pull_force_date between #{start} AND #{end}
        AND workshop_id IN
        <foreach collection="idSet" item="id"  open="(" close=")"  separator=",">
            #{id}
        </foreach>
        GROUP BY  pullForceDateStr
    </select>

    <select id="selectPullForceByMonth" resultType="com.steccn.pms.dto.PmsPullForceDayCountDTO">
        SELECT SUM(quantity) AS quantity,
        DATE_FORMAT(pull_force_date,'%Y-%m') pullForceDateStr
        FROM pms_pull_force
        WHERE del_flag = 0
        AND pull_force_date between #{start} AND #{end}
        AND workshop_id IN
        <foreach collection="idSet" item="id"  open="(" close=")"  separator=",">
            #{id}
        </foreach>
        GROUP BY  pullForceDateStr
    </select>

    <select id="selectPullForceByYear" resultType="com.steccn.pms.dto.PmsPullForceDayCountDTO">
        SELECT SUM(quantity) AS quantity,
        DATE_FORMAT(pull_force_date,'%Y') pullForceDateStr
        FROM pms_pull_force
        WHERE del_flag = 0
        AND pull_force_date between #{start} AND #{end}
        AND workshop_id IN
        <foreach collection="idSet" item="id"  open="(" close=")"  separator=",">
            #{id}
        </foreach>
        GROUP BY  pullForceDateStr
    </select>

</mapper>
