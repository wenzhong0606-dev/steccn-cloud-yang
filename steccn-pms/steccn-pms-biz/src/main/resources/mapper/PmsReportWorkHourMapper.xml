<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsReportWorkHourMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsReportWorkHour">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="causeId" column="cause_id" jdbcType="BIGINT"/>
            <result property="manHour" column="man_hour" jdbcType="FLOAT"/>
            <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
            <result property="reportWorkId" column="report_work_id" jdbcType="BIGINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,cause_id,man_hour,
        unit_id,report_work_id,create_by,
        create_name,create_time,update_by,
        update_name,update_time,del_flag
    </sql>
    <select id="countReportStop" resultType="com.steccn.pms.vo.SjgCountReportStopRowVO">
        SELECT
            process.`name` as processName,
            rw.station_id,
            rw.class_date,
            wh.note,
            wh.man_hour
        FROM
            pms_report_work_hour wh
                JOIN pms_report_work rw ON wh.report_work_id = rw.id
                JOIN pms_produce_order_craft craft ON rw.process_id = craft.id
                JOIN pm_process process ON process.id = craft.process_id
        WHERE
            rw.del_flag = 0
          AND craft.del_flag = 0
          AND process.del_flag = 0
          AND rw.product_line_id = #{lineId}
          AND rw.class_date BETWEEN #{start} AND #{end}
        order by process.id

    </select>
</mapper>
