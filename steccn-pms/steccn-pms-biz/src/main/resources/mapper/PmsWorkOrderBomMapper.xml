<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.pms.mapper.PmsWorkOrderBomMapper">

    <resultMap id="BaseResultMap" type="com.steccn.pms.domain.PmsWorkOrderBom">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="moduleId" column="module_id" jdbcType="OTHER"/>
        <result property="quantity" column="quantity" jdbcType="DECIMAL"/>
        <result property="unitId" column="unit_id" jdbcType="BIGINT"/>
        <result property="processId" column="process_id" jdbcType="BIGINT"/>
        <result property="fixedQuantityFlag" column="fixed_quantity_flag" jdbcType="TINYINT"/>
        <result property="backCalculateFlag" column="back_calculate_flag" jdbcType="TINYINT"/>
        <result property="jointProductFlag" column="joint_product_flag" jdbcType="TINYINT"/>
        <result property="workProduceId" column="work_produce_id" jdbcType="BIGINT"/>
        <result property="createBy" column="create_by" jdbcType="BIGINT"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
        <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,module_id,quantity,
        unit_id,process_id,fixed_quantity_flag,
        copruduct_flag,back_calculate_flag,joint_product_flag,
        work_produce_id,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>
    <select id="materialOrderStation" resultType="com.steccn.common.dto.TupleDTO">
        SELECT
        bom.module_id as field1,
        GROUP_CONCAT( DISTINCT pwocs.execute_station_id ) as field2
        FROM
        pms_work_order_craft_station pwocs
        JOIN pms_produce_order_craft ppoc ON ppoc.id = pwocs.produce_order_craft_id
        JOIN pms_work_order_bom bom ON bom.work_produce_id = ppoc.produce_order_id and bom.process_id = ppoc.process_id
        WHERE
        (pwocs.del_flag = 0 AND ppoc.del_flag = 0 AND bom.del_flag = 0)
        <if test="conditionList !=null and conditionList.size > 0">
            AND
            <foreach collection="conditionList" item="condition" open="(" close=")" separator="or">
                ( bom.module_id = #{condition.field2} AND bom.work_produce_id = #{condition.field1} )
            </foreach>
        </if>
        group by bom.module_id
    </select>
    <select id="listStation" resultType="com.steccn.pms.dto.BomStationDTO">
        SELECT
        a.module_id as materialId,
        c.execute_station_id,
        c.execute_station_name,
        c.execute_station_code
        FROM
        pms_work_order_bom a
        JOIN pm_process b ON a.process_id = b.id
        JOIN pm_process_station c ON c.process_id = b.id
        WHERE
        c.del_flag = 0 and
        a.id in
        <foreach collection="bomIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
