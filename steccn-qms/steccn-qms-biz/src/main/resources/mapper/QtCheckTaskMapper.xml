<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.qms.mapper.QtCheckTaskMapper">

    <resultMap id="BaseResultMap" type="com.steccn.qms.domain.QtCheckTask">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="type" column="type" jdbcType="TINYINT"/>
        <result property="materialId" column="material_id" jdbcType="INTEGER"/>
        <result property="productWorkshop" column="product_workshop"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="productLine" column="product_line"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="materialWorkshop" column="material_workshop"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="supplier" column="supplier"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="customer" column="customer"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="productWorkshopId" column="workshop_id" jdbcType="INTEGER"/>
        <result property="productLineId" column="product_line_id" jdbcType="INTEGER"/>
        <result property="productOrder" column="product_order" jdbcType="VARCHAR"/>
        <result property="productBatch" column="product_batch" jdbcType="VARCHAR"/>
        <result property="checkPlanId" column="check_plan_id" jdbcType="INTEGER"/>
        <result property="status" column="status" jdbcType="TINYINT"/>
        <result property="checkNum" column="check_num" jdbcType="INTEGER"/>
        <result property="goodNum" column="good_num" jdbcType="INTEGER"/>
        <result property="badNum" column="bad_num" jdbcType="INTEGER"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="classesId" column="classes_id" jdbcType="INTEGER"/>
        <result property="classTime" column="class_time" jdbcType="TIMESTAMP"/>
        <result property="spotTime" column="spot_time" jdbcType="TIMESTAMP"/>
        <result property="note" column="note" jdbcType="VARCHAR"/>
        <result property="createBy" column="create_by" jdbcType="BIGINT"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
        <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <resultMap id="TaskResultMap" type="com.steccn.qms.vo.QtIQCAcceptabilityDetailVO">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="materialId" column="material_id" jdbcType="INTEGER"/>
        <result property="productWorkshop" column="product_workshop"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="materialWorkshop" column="material_workshop"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="supplier" column="supplier"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="customer" column="customer"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="samplingTime" column="sampling_time" jdbcType="TIMESTAMP"/>
        <result property="finishedTime" column="finished_time" jdbcType="TIMESTAMP"/>
        <result property="code" column="code" jdbcType="VARCHAR"/>
    </resultMap>


    <resultMap id="SamplingMap" type="com.steccn.qms.dto.QtDaySamplingDTO">
        <id property="taskId" column="task_id" jdbcType="BIGINT"/>

        <result property="ingredientNum" column="ingredient_num" jdbcType="INTEGER"/>
        <result property="checkResult" column="check_result" jdbcType="VARCHAR"/>
        <result property="note" column="note" jdbcType="VARCHAR"/>
        <result property="itemId" column="item_id" jdbcType="INTEGER"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="samplingTime" column="sampling_time" jdbcType="TIMESTAMP"/>
        <result property="copy" column="copy" jdbcType="INTEGER"/>
    </resultMap>

    <resultMap id="IncomingMap" type="com.steccn.qms.dto.QtIncomingCheckDTO">
        <id property="taskId" column="task_id" jdbcType="BIGINT"/>
        <result property="taskCode" column="task_code" jdbcType="VARCHAR"/>
        <result property="ingredientNum" column="ingredient_num" jdbcType="INTEGER"/>
        <result property="checkResult" column="check_result" jdbcType="VARCHAR"/>
        <result property="note" column="note" jdbcType="VARCHAR"/>
        <result property="itemId" column="item_id" jdbcType="INTEGER"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="samplingTimeArray" column="sampling_time_array"
                typeHandler="com.steccn.common.convert.LocalDateTimeTypeHandler"/>
        <result property="materialWorkshop" column="material_workshop"
                typeHandler="com.steccn.qms.constant.IdNameTypeHandler"/>
        <result property="supplier" column="supplier"
                typeHandler="com.steccn.qms.constant.IdNameTypeHandler"/>
        <result property="copy" column="copy" jdbcType="INTEGER"/>
    </resultMap>

    <resultMap id="OtherComingMap" type="com.steccn.qms.dto.QtOtherCheckDTO">
        <id property="taskId" column="task_id" jdbcType="BIGINT"/>
        <result property="taskCode" column="task_code" jdbcType="VARCHAR"/>
        <result property="result" column="result" jdbcType="VARCHAR"/>
        <result property="note" column="note" jdbcType="VARCHAR"/>
        <result property="checkResult" column="check_result" jdbcType="VARCHAR"/>
        <result property="itemId" column="item_id" jdbcType="INTEGER"/>
        <result property="finishTime" column="finish_Time" jdbcType="TIMESTAMP"/>
        <result property="materialWorkshop" column="material_workshop"
                typeHandler="com.steccn.qms.constant.IdNameTypeHandler"/>
        <result property="supplier" column="supplier"
                typeHandler="com.steccn.qms.constant.IdNameTypeHandler"/>
    </resultMap>

    <select id="rateDataList" resultMap="BaseResultMap">
        SELECT
        id,
        type type,
        material_id material_id,
        product_line product_line,
        product_order product_order,
        material_workshop,
        product_batch product_batch,
        STATUS STATUS,
        check_num check_num,
        good_num good_num,
        bad_num bad_num,
        result result,
        supplier supplier,
        customer customer,
        deliver_order deliver_order,
        task_type task_type,
        deliver_num deliver_num,
        product_workshop product_workshop,
        classes_id classes_id,
        class_time,
        CODE CODE,
        finished_time,
        spot_time
        FROM
        qt_check_task
        WHERE
        del_flag = 0
        <if test="dto.productWorkShopId != null">
            AND (product_workshop ->> '$.id' = #{dto.productWorkShopId})
        </if>
        <if test="dto.materialWorkshopId != null ">
            AND (material_workshop ->> '$.id' = #{dto.materialWorkshopId})
        </if>
        <if test="dto.productLineId != null ">
            AND (product_line ->> '$.id' = #{dto.productLineId})
        </if>
        <if test="dto.customer != null">
            AND (customer ->> '$.id' = #{dto.customer})
        </if>
        <if test="dto.supplierId != null">
            AND (supplier ->> '$.id' = #{dto.supplierId})
        </if>
        <if test="dto.materialId != null">
            AND material_id = #{dto.materialId}
        </if>
        <if test="dto.workingOrder != null">
            AND classes_id = #{dto.workingOrder}
        </if>
        <if test="line != null and line.size > 0">
            AND
            <foreach collection="line" item="lineId" open="(" close=")" separator="or">
                (product_line ->> '$.id' = #{lineId})
            </foreach>
        </if>
        AND task_type = #{dto.taskType}
        <choose>
            <when test="dto.taskType == 4">
                AND spot_time &gt;= #{dto.dateTimeStart}
                AND spot_time &lt;= #{dto.dateTimeEnd}
            </when>
            <otherwise>
                AND finished_time &gt;= #{dto.dateTimeStart}
                AND finished_time &lt;= #{dto.dateTimeEnd}
            </otherwise>
        </choose>
        AND status = 2
        ORDER BY CODE ASC
    </select>
    <select id="pageList" resultMap="TaskResultMap">
        SELECT
        a.id id,
        a.code code,
        a.material_workshop material_workshop,
        a.product_workshop product_workshop,
        a.result result,
        a.finished_time finished_time,
        a.material_id material_id,
        a.supplier supplier,
        IFNULL(a.good_num,0) as good_num,
        IFNULL(a.check_num,0) as check_num
        FROM
        qt_check_task a
        LEFT JOIN qt_material c ON c.id = a.material_id
        <where>
            a. task_type = 1 and a.del_flag = 0
            <if test="dto.materialWorkshopId != null">
                AND (product_workshop ->> '$.id' = #{dto.productWorkShopId})
            </if>
            <if test="dto.supplierId != null and dto.supplierId != ''">
                AND (supplier ->> '$.id') = #{dto.supplierId}
            </if>
            <if test="dto.materialId != null and dto.materialId != ''">
                and a.material_id = #{dto.materialId}
            </if>
            <if test="dto.dateTimeStart !=null and dto.dateTimeEnd !=null">
                and a.finished_time between #{dto.dateTimeStart} and #{dto.dateTimeEnd}
            </if>
            <if test="dto.samplingStartTime != null and dto.samplingEndTime != null">
                and b.sampling_time between #{dto.samplingStartTime} and #{dto.samplingEndTime}
            </if>
        </where>
    </select>
    <select id="list" resultMap="TaskResultMap">
        SELECT
        a.id id,
        a.code code,
        a.material_workshop material_workshop,
        a.product_workshop product_workshop,
        a.result result,
        a.finished_time finished_time,
        b.sampling_time sampling_time,
        a.material_id material_id,
        a.supplier supplier,
        IFNULL(a.good_num,0) as good_num,
        IFNULL(a.check_num,0) as check_num
        FROM
        qt_check_task a
        LEFT JOIN qt_check_task_copy b ON b.task_id = a.id
        LEFT JOIN qt_material c ON c.id = a.material_id
        <where>
            a. task_type = 1 and a.del_flag = 0
            <if test="dto.materialWorkshopId != null">
                AND (product_workshop ->> '$.id' = #{dto.productWorkShopId})
            </if>
            <if test="dto.supplierId != null and dto.supplierId != ''">
                AND (supplier ->> '$.id') = #{dto.supplierId}
            </if>
            <if test="dto.materialId != null and dto.materialId != ''">
                and a.material_id = #{dto.materialId}
            </if>
            <if test="dto.dateTimeStart !=null and dto.dateTimeEnd !=null">
                and a.finished_time between #{dto.dateTimeStart} and #{dto.dateTimeEnd}
            </if>
            <if test="dto.samplingStartTime != null and dto.samplingEndTime != null">
                and b.sampling_time between #{dto.samplingStartTime} and #{dto.samplingEndTime}
            </if>
        </where>
    </select>
    <select id="getDefectItemList" resultType="com.steccn.qms.vo.QtDefectItemInfoVO">
        SELECT
        a.id as taskId,a.classes_id,c.id,c.name,e.id as categoryId,e.name as categoryName
        FROM
        qt_check_task a
        JOIN qt_check_task_detail b ON b.task_id = a.id
        JOIN qt_defective_item c on c.id = b.defect_id
        JOIN qt_check_item d on b.item_id = d.id
        join qt_item_category e on c.category_id = e.id
        where
        d.name = #{apparentCondition}
        <if test="taskIds !=null and taskIds.size > 0">
            and a.id in
            <foreach collection="taskIds" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
        </if>
    </select>
    <select id="samplingList" resultMap="SamplingMap">
        SELECT
            task.id as task_id,
            copy.ingredient_num,
            detail.check_result ,
            task.note,
            detail.item_id,
            task.result,
            copy.sampling_time,
            copy.copy
        FROM
            qt_check_task task
                JOIN qt_check_task_copy copy ON task.id = copy.task_id and copy.del_flag = 0
                JOIN qt_check_task_detail detail ON task.id = detail.task_id and detail.del_flag = 0 and copy.copy = detail.copy
        WHERE
            task.del_flag = 0
            AND task.task_type = 7
            AND task.status = 2
        <if test="morning != null and morning != null">
            AND copy.sampling_time between #{morning} and #{night}
        </if>
    </select>
    <select id="comingList" resultMap="IncomingMap">
        SELECT
            task.id as task_id,
            task.code as task_code,
            copy.ingredient_num,
            detail.check_result ,
            task.note,
            detail.item_id,
            task.result,
            copy.sampling_time_array,
            copy.copy,
            task.material_workshop,
            task.supplier
        FROM
            qt_check_task task
                JOIN qt_check_task_copy copy ON task.id = copy.task_id and copy.del_flag = 0
                JOIN qt_check_task_detail detail ON task.id = detail.task_id and detail.del_flag = 0 and copy.copy = detail.copy
        WHERE
            task.del_flag = 0
            AND task.status =2
            AND task.task_type = 1
            AND copy.sampling_time_array is not null
            <if test="itemIdSet !=null and itemIdSet.size > 0">
                and detail.item_id in
                <foreach collection="itemIdSet" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
    </select>
    <select id="otherList" resultMap="OtherComingMap">
        SELECT
            task.id AS task_id,
            task.CODE AS task_code,
            task.result,
            task.note,
            detail.check_result,
            detail.item_id,
            task.finished_time as finish_time,
            task.material_workshop,
            task.supplier
        FROM
            qt_check_task task
                JOIN qt_check_task_detail detail ON task.id = detail.task_id
        WHERE
            task.del_flag = 0
          AND detail.del_flag = 0
          AND task.STATUS = 2
          AND finished_time &gt;= #{start}
          AND finished_time &lt;= #{end}
          AND task.task_type = #{checkType}
          <if test="itemIdSet !=null and itemIdSet.size > 0">
            and detail.item_id in
            <foreach collection="itemIdSet" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
         </if>
    </select>
</mapper>
