    <resultMap id="TaskResultMap" type="com.steccn.qms.vo.QtCheckTaskDetailItemMaterialVO">

        <result property="materialId" column="materialId" jdbcType="INTEGER"/>
        <result property="productLine" column="productLine"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="classId" column="classId" jdbcType="INTEGER"/>
        <result property="classTime" column="classTime" jdbcType="DATE"/>
        <result property="itemName" column="itemName" jdbcType="VARCHAR"/>
        <result property="checkResult" column="checkResult" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="listByTaskId" resultType="com.steccn.qms.vo.QtSubtableVO">
        SELECT
        a.id AS label,
        b.NAME,
        a.check_result AS value,
        a.copy,
        a.task_id,
        c.sample_num,
        c.license_plate,
        c.ingredient_num,
        c.sampling_time
        FROM
        qt_check_task_detail a
        JOIN qt_check_item b ON a.item_id = b.id
        JOIN qt_check_task_copy c ON c.task_id = a.task_id
        AND c.copy = a.copy
        WHERE a.del_flag = 0
        AND a.task_id in (
        <foreach collection="taskIds" item="id" separator=",">
            #{id}
        </foreach>)
    </select>
    <select id="selectAllByClassTime" resultMap="TaskResultMap">
        SELECT
	        i.`name` itemName,
	        d.check_result checkResult,
	        t.material_id materialId,
	        t.class_time classTime,
	        t.classes_id classId,
	        t.product_line productLine
        FROM
	        qt_check_task t
	        left JOIN qt_check_task_detail d ON t.id = d.task_id
	        left JOIN qt_check_item i ON d.item_id = i.id
        WHERE
	        t.task_type = 4
	        and t.class_time &gt;= #{startTime}
	        and t.class_time &lt;= #{endTime}
    </select>
</mapper>
