    <select id="listByTaskId" resultType="com.steccn.qms.vo.QtSubtableVO">
        SELECT
        a.id AS label,
        b.NAME,
        a.check_result AS value,
        a.copy,
        a.task_id,
        c.sample_num,
        c.license_plate,
        c.ingredient_num,
        c.sampling_time
        FROM
        qt_check_task_detail a
        JOIN qt_check_item b ON a.item_id = b.id
        JOIN qt_check_task_copy c ON c.task_id = a.task_id
        AND c.copy = a.copy
        WHERE a.del_flag = 0
        AND a.task_id in (
        <foreach collection="taskIds" item="id" separator=",">
            #{id}
        </foreach>)
    </select>
    <select id="selectAllByClassTime" resultType="com.steccn.qms.vo.QtCheckTaskDetailItemMaterialVO">
        SELECT
	        i.`name` itemName,
	        d.check_result checkResult,
	        t.material_id materialId,
	        m.thick_quantity thickQuantity,
	        t.class_time classTime,
	        t.classes_id classId
        FROM
	        qt_check_task t
	        INNER JOIN qt_check_task_detail d ON t.id = d.task_id
	        INNER JOIN qt_defective_item i ON d.item_id = i.id
	        INNER JOIN qt_material m ON t.material_id = m.id
        WHERE
	        t.task_type = 4
	        and t.classTime &gt;= #{startDate},
	        and t.classTime &lt;= #{endDate}
    </select>
</mapper>
