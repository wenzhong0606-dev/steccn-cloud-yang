    <select id="selectSaleName" resultType="com.steccn.sales.dto.KsSaleIdAndNameDTO">
        SELECT
        ru.id AS saleId,
        rp.name As saleName
        FROM
        res_users ru
        LEFT join  res_partner rp ON ru.partner_id = rp.id
        WHERE
            ru.id in
            <foreach collection="saleIdSet" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
    </select>
