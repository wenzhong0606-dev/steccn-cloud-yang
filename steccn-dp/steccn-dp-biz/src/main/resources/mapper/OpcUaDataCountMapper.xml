<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.dp.mapper.OpcUaDataCountMapper">

    <resultMap id="BaseResultMap" type="com.steccn.dp.domain.OpcUaDataCount">
            <result property="path" column="path" jdbcType="OTHER"/>
            <result property="id" column="id" jdbcType="OTHER"/>
            <result property="idValue" column="id_value" jdbcType="OTHER"/>
            <result property="dt" column="dt" jdbcType="TIMESTAMP"/>
            <result property="idCategory" column="id_category" jdbcType="OTHER"/>
    </resultMap>

    <sql id="Base_Column_List">
        path,id,id_value,
        dt,id_category
    </sql>
    <select id="detail" resultType="com.steccn.dp.domain.OpcUaDataCount">
        select ct.id as id , psm.site as path , sum(id_value) as id_value  from point_site_map psm join opc_ua_data_count ct on ct.id = psm.id  where ct.dt = #{time} and ct.id_category  = #{category}
        group by ct.id , psm.site
    </select>
</mapper>
