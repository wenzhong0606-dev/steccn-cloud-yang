    <select id="selectGroupLeader" resultType="com.steccn.oa.dto.OaClassUserNameDTO">
        SELECT hrm.LASTNAME AS userName, department.DEPARTMENTNAME AS className
            FROM hrmresource hrm
            LEFT JOIN hrmdepartment department
            ON hrm.DEPARTMENTID = department.id
            LEFT JOIN hrmjobtitles job
            ON hrm.JOBTITLE = job.id
            WHERE hrm.STATUS != 5
            AND job.id = #{jobId}
