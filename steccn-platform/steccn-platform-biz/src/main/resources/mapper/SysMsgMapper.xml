<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.platform.mapper.SysMsgMapper">

    <resultMap id="pageMap" type="com.steccn.platform.vo.SysMsgPageVO">
        <id property="msgId" column="id" jdbcType="BIGINT"/>
        <result property="type" column="type" jdbcType="INTEGER"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="addition" column="addition"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="createName" column="create_name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="readFlag" column="read_flag" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        ,type,title,
        content,create_by,create_name,
        create_time,update_by,update_name,
        update_time,del_flag
    </sql>
    <select id="tabCount" resultType="java.lang.Integer">
        SELECT count(1) FROM sys_msg m join sys_msg_user u on m.id = u.msg_id
        where m.type in
        <foreach collection="typeList" item="type" open="(" close=")" separator=",">
            #{type}
        </foreach>
        and u.user_id = #{userId}
    </select>
    <select id="msgPage" resultMap="pageMap">
        SELECT m.id , m.title, m.content, m.addition, m.create_name, m.create_time , u.read_flag , m.type
        FROM sys_msg m join sys_msg_user u on m.id = u.msg_id
        where m.type in
        <foreach collection="typeList" item="type" open="(" close=")" separator=",">
            #{type}
        </foreach>
        and u.user_id = #{userId}
        <if test="page.idx != null and page.idx  != ''">
            and m.id &lt; #{page.idx}
        </if>
        order by m.id desc
        limit #{page.size}
    </select>
</mapper>
