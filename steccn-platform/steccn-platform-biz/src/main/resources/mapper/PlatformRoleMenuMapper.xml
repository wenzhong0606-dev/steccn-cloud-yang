<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.platform.mapper.PlatformRoleMenuMapper">

    <resultMap id="BaseResultMap" type="com.steccn.platform.domain.PlatformRoleMenu">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="roleId" column="role_id" jdbcType="BIGINT"/>
            <result property="menuId" column="menu_id" jdbcType="INTEGER"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,role_id,menu_id,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag
    </sql>

    <select id="selectAncestors" parameterType="java.util.Set" resultType="java.lang.Integer">
        WITH RECURSIVE ancestors AS (
        -- 初始：多个叶子节点
        SELECT id, parent_id
        FROM platform_menu
        WHERE id IN
        <foreach collection="leafIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>

        UNION ALL

        -- 递归往上查父节点
        SELECT t.id, t.parent_id
        FROM platform_menu t
        INNER JOIN ancestors a ON t.id = a.parent_id
        )
        SELECT DISTINCT id
        FROM ancestors
        WHERE id NOT IN
        <foreach collection="leafIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
