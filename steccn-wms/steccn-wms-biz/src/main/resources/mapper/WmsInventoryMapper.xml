    <update id="subtractLockQuantity">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update wms_inventory
            <set>
                lock_quantity = lock_quantity + #{item.quantity},
                available_quantity = available_quantity - #{item.quantity}
            </set>
            where id = #{item.id}
        </foreach>
    </update>
    <update id="augmentLockQuantity">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update wms_inventory
            <set>
                lock_quantity = lock_quantity + #{item.quantity},
                available_quantity = available_quantity - #{item.quantity}
            </set>
            where id = #{item.id}
        </foreach>
    </update>
    <update id="subtractFirstAndThenAddLockQuantity">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update wms_inventory
            <set>
                lock_quantity = lock_quantity - #{item.originalQuantity} + #{item.quantity},
                available_quantity = available_quantity + #{item.originalQuantity} - #{item.quantity}
            </set>
            where id = #{item.id}
        </foreach>
    </update>
    <update id="updateLockAndTotalQuantity">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update wms_inventory
            <set>
                lock_quantity = lock_quantity - #{item.quantity},
                available_quantity = available_quantity - #{item.quantity},
                tatal_quantity = tatal_quantity - #{item.quantity}
            </set>
            where id = #{item.id}
        </foreach>
    </update>
    <select id="listMaterialInventory" resultType="com.steccn.wms.domain.WmsInventory">
        SELECT
        a.material_id,
        a.available_quantity AS availableQuantity
        FROM
        wms_inventory a
        WHERE
        <foreach collection="list" item="dto" open="(" separator="OR" close=")">
            ( a.material_id = #{dto.materialId} and a.shelf_code in
            <foreach collection="dto.shelfCodes" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
        </foreach>
    </select>

    <select id="getByShelfCodeOrMaterialsInventoryList" resultType="com.steccn.pms.vo.WmsStockVO">
        SELECT
          a.id inventoryId ,a.material_id materialId,a.material_name materialName,a.available_quantity availableQuantity,
          a.total_quantity totalQuantity,a.unit unitId,a.case_no caseNo,a.batch batchNo,a.warehouse_id warehouse,
          a.warehouse_name warehouseName,a.shelf_id shelf,a.shelf_name shelfName,a.material_code materialCode
        FROM
        wms_inventory a
        WHERE   a.del_flag = 0
        <if test="shelfCodes!=null and shelfCodes.size() >0 ">
            <foreach collection="shelfCodes" open=" and a.shelf_code in(" close=")" item="shelfCode" separator=",">
                #{shelfCode}
            </foreach>
        </if>
        <if test="materialsList!=null and materialsList.size() >0 ">
            <foreach collection="materialsList" open=" and a.material_id in(" close=")" item="materials" separator=",">
                #{materials}
            </foreach>
        </if>

    </select>
    <select id="getWhMaterial" resultType="java.lang.Long">
        select distinct material_id from         wms_inventory a
        WHERE   a.del_flag = 0
        <if test="warehouseIds!=null and warehouseIds.size() >0 ">
            and a.warehouse_id in
            <foreach collection="warehouseIds" open="(" close=")" item="warehouseId" separator=",">
                #{warehouseId}
            </foreach>
        </if>
    </select>
    <select id="openingInventory" resultType="com.steccn.common.dto.TupleDTO">
        select distinct material_id as field1, back_lock_quantity as field2 from wms_inventory_record where del_flag = 0
        and (material_id , create_time) in (

        select material_id, max(create_time)   from wms_inventory_record
        where material_id in (select distinct material_id from wms_inventory where del_flag = 0
        <if test="warehouseIds!=null and warehouseIds.size() >0 ">
            and warehouse_id in
            <foreach collection="warehouseIds" open="(" close=")" item="warehouseId" separator=",">
                #{warehouseId}
            </foreach>
        </if> )
        <if test="date!=null">
            and create_time &lt;= #{date}
        </if>
               group by material_id
        )
    </select>
    <select id="inventory" resultType="java.math.BigDecimal">
        SELECT SUM(total_quantity)
        FROM wms_inventory
        WHERE warehouse_id IN
        <foreach collection="warehouseIds" open="(" close=")" item="warehouseId" separator=",">
            #{warehouseId}
        </foreach>
    </select>


