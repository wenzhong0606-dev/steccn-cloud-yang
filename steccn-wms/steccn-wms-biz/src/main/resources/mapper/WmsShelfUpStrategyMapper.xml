<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.wms.mapper.WmsShelfUpStrategyMapper">

    <resultMap id="BaseResultMap" type="com.steccn.wms.domain.WmsShelfUpStrategy">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="materialId" column="material_id" jdbcType="BIGINT"/>
            <result property="materialCode" column="material_code" jdbcType="VARCHAR"/>
            <result property="materialName" column="material_name" jdbcType="VARCHAR"/>
            <result property="storageLocation" column="storage_location" jdbcType="OTHER"/>
            <result property="maxStorageQuantity" column="max_storage_quantity" jdbcType="DECIMAL"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createName" column="create_name" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateName" column="update_name" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,material_id,material_code,
        material_name,storage_location,max_storage_quantity,
        create_by,create_name,create_time,
        update_by,update_name,update_time,
        del_flag
    </sql>

    <select id="getShelfUpStrategyList" resultType="com.steccn.wms.domain.WmsShelfUpStrategy">
        select  id,material_id,material_code, material_name, max_storage_quantity,
        storage_location,note, create_by,create_name,create_time, update_by,update_name,update_time, del_flag
        from wms_shelf_up_strategy
        where del_flag = 0
        <if test="wmsShelfUpStrategyDTO.keyWord!=null and wmsShelfUpStrategyDTO.keyWord!=''">
            and ( material_code like CONCAT('%',#{wmsShelfUpStrategyDTO.keyWord},'%') or material_name like CONCAT('%',#{wmsShelfUpStrategyDTO.keyWord},'%') )
        </if>
        order by create_time desc
    </select>

</mapper>
