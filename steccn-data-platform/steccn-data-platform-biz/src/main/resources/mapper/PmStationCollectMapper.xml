<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.data.mapper.PmStationCollectMapper">

    <resultMap id="BaseResultMap" type="com.steccn.data.domain.PmStationCollect">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="recordTime" column="record_time" jdbcType="TIMESTAMP"/>
            <result property="value" column="value" jdbcType="NUMERIC"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,record_time,
        value,create_time
    </sql>
    <select id="rwPreLoad" resultType="com.steccn.data.domain.PmStationCollect">
        SELECT
         *
        FROM
         pm_station_collect
        WHERE
            (ID = ( SELECT ID FROM ep_meter_collect WHERE code = #{dto.code} AND record_time &lt;= #{dto.startTime} ORDER BY record_time DESC LIMIT 1 ))
           OR
            (ID = ( SELECT ID FROM ep_meter_collect WHERE code = #{dto.code} AND record_time &lt;= #{dto.endTime} ORDER BY record_time DESC LIMIT 1 ))
    </select>
</mapper>
