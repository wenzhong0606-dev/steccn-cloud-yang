<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.steccn.data.mapper.EpMeterCollectMapper">

    <resultMap id="BaseResultMap" type="com.steccn.data.domain.EpMeterCollect">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="recordTime" column="record_time" jdbcType="TIMESTAMP"/>
            <result property="value" column="value" jdbcType="NUMERIC"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,record_time,
        value,create_time
    </sql>
    <select id="batchSearch" resultType="com.steccn.data.domain.EpMeterCollect">
        SELECT
        *
        FROM
        ep_meter_collect
        WHERE
        <foreach collection="dwList" item="dw"  open="(" close=")" separator="or">
           (ID = ( SELECT ID FROM ep_meter_collect WHERE code = #{dw.code} AND record_time &lt;= #{dw.end} ORDER BY record_time DESC LIMIT 1 ))
        </foreach>

    </select>
</mapper>
