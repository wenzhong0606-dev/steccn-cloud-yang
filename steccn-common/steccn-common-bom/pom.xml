<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.steccn</groupId>
    <artifactId>steccn-common-bom</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <spring-cloud.version>2020.0.4</spring-cloud.version>
        <spring-boot.version>2.5.6</spring-boot.version>
        <spring-cloud-alibaba.version>2021.1</spring-cloud-alibaba.version>
        <steccn-cloud.version>0.0.1-SNAPSHOT</steccn-cloud.version>
        <hutool-all.version>5.7.15</hutool-all.version>
        <commons-lang.version>2.6</commons-lang.version>
        <lombok.version>1.18.22</lombok.version>
        <validation-api.version>2.0.1.Final</validation-api.version>
        <mybatis-plus.version>3.2.0</mybatis-plus.version>
        <mysql-connector.version>8.0.17</mysql-connector.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- spring boot dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- spring cloud dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- spring cloud alibaba dependencies -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- common core -->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-core</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>

            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>user-center</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>auth-server</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-common-data-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-data</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-user-center-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-user-center-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-user-center-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-user-center-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-pms-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-pms-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-pms-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-pms-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-qms-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-qms-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-qms-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-qms-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-portal-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-portal-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-portal-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-portal-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-oa-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-oa-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-oa-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-oa-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>

            <!--lombok-->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!--hutool-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>
            <!--commons-lang-->
            <dependency>
                <groupId>commons-lang</groupId>
                <artifactId>commons-lang</artifactId>
                <version>${commons-lang.version}</version>
            </dependency>
            <!--validation -->
            <dependency>
                <groupId>javax.validation</groupId>
                <artifactId>validation-api</artifactId>
                <version>${validation-api.version}</version>
            </dependency>
            <!--mybatis-plus-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--导入mysql驱动-->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>