<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.steccn</groupId>
    <artifactId>steccn-cloud</artifactId>
    <version>1.0.0</version>
    <name>steccn-cloud</name>
    <packaging>pom</packaging>
    <description>steccn-cloud</description>
    <modules>
        <module>steccn-auth-server</module>
        <module>steccn-gateway</module>
        <module>steccn-common</module>
        <module>steccn-qms</module>
        <module>steccn-pms</module>
        <module>steccn-portal</module>
        <module>steccn-user-center</module>
        <module>steccn-oa</module>
        <module>steccn-platform</module>
        <module>steccn-minio</module>
        <module>steccn-monitor</module>
        <module>steccn-wms</module>
        <module>steccn-ems</module>
        <module>steccn-data-platform</module>
        <module>steccn-websocket</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <spring-cloud.version>2020.0.4</spring-cloud.version>
        <spring-boot.version>2.5.6</spring-boot.version>
        <spring-cloud-alibaba.version>2021.1</spring-cloud-alibaba.version>
        <steccn-cloud.version>1.0.0</steccn-cloud.version>
        <hutool-all.version>5.7.15</hutool-all.version>
        <commons-lang.version>2.6</commons-lang.version>
        <lombok.version>1.18.22</lombok.version>
        <validation-api.version>2.0.1.Final</validation-api.version>
        <mybatis-plus.version>3.2.0</mybatis-plus.version>
        <mysql-connector.version>8.0.17</mysql-connector.version>
        <minio.version>7.0.2</minio.version>
        <spring-cloud-starter-zipkin.version>2.2.6.RELEASE</spring-cloud-starter-zipkin.version>
        <nimbus-jose-jwt.version>9.23</nimbus-jose-jwt.version>
        <knife4j.version>3.0.3</knife4j.version>
        <pinyin.version>1.1.8</pinyin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- spring boot dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- spring cloud dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- spring cloud alibaba dependencies -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- common core -->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-core</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-auth-server</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-common-data-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-data</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-user-center-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-user-center-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-user-center-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-user-center-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-pms-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-pms-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-pms-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-pms-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-qms-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-qms-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-qms-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-qms-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-portal-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-portal-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-portal-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-portal-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-oa-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-oa-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-oa-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-oa-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-common-oauth-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-oauth</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-platform-api-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-platform-api</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>
            <!--steccn-platform-biz-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-platform-biz</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>

            <!--redis-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-redis</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>

            <!-- log日志-->
            <dependency>
                <groupId>com.steccn</groupId>
                <artifactId>steccn-common-log</artifactId>
                <version>${steccn-cloud.version}</version>
            </dependency>

            <!--lombok-->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!--hutool-->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>
            <!--commons-lang-->
            <dependency>
                <groupId>commons-lang</groupId>
                <artifactId>commons-lang</artifactId>
                <version>${commons-lang.version}</version>
            </dependency>
            <!--validation -->
            <dependency>
                <groupId>javax.validation</groupId>
                <artifactId>validation-api</artifactId>
                <version>${validation-api.version}</version>
            </dependency>
            <!--mybatis-plus-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--导入mysql驱动-->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-starter-client</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <!-- jwt-->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <!--Swagger3增加工具-->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <!-- zipkin  -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-zipkin</artifactId>
                <version>${spring-cloud-starter-zipkin.version}</version>
            </dependency>
            <!-- 拼音组件 -->
            <dependency>
                <groupId>com.github.stuxuhai</groupId>
                <artifactId>jpinyin</artifactId>
                <version>${pinyin.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--spring boot 默认插件-->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>2.5.6</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
